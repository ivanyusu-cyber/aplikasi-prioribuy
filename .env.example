# Salin nilai ini ke Vercel: Project > Settings > Environment Variables. (Untuk uji lokal: export di terminal.)
# TIDAK ADA kredensial asli di file ini.
SUPABASE_URL=https://GANTI-DENGAN-PROJECT-REF.supabase.co
# anon / publishable key (Supabase > Project Settings > API). Boleh publik; keamanan data dijaga RLS.
SUPABASE_ANON_KEY=GANTI_DENGAN_ANON_ATAU_PUBLISHABLE_KEY
# JANGAN pernah menaruh service_role / secret key di Vercel Environment Variables untuk website ini.
